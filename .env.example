# Copy this file to .env and fill in what you need.
# For the Phase 1 web chat, you don't need anything here — just run
# `claude /login` once (scripts/setup.sh will prompt you) and leave this
# file alone.

# Only needed once you get to headless/scheduled use (Phase 5+), where no
# one is present to complete an interactive browser login. Generate with:
#   claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Port the local web server listens on.
EV_PORT=8765
