# Copy this file to .env and fill in what you need.
# For the Phase 1 web chat, you don't need anything here — just run
# `claude /login` once (scripts/setup.sh will prompt you) and leave this
# file alone.

# Only needed once you get to headless/scheduled use (Phase 5+), where no
# one is present to complete an interactive browser login. Generate with:
#   claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Port the local web server listens on.
EV_PORT=8765

# --- Optional integrations (docs/SETUP.md has step-by-step setup for each) ---

# Tasks: free Todoist account -> Settings -> Integrations -> Developer -> API token
TODOIST_API_TOKEN=

# Canvas: your school's Canvas URL, and Account -> Settings -> New Access Token.
# Some schools block student self-service token creation — if yours does,
# just leave these blank; check-deadlines still works without Canvas.
CANVAS_BASE_URL=
CANVAS_ACCESS_TOKEN=

# Calendar: no env var — save an OAuth client ID (Desktop app) from Google
# Cloud Console as harness/.secrets/google_credentials.json instead. See
# docs/SETUP.md.
